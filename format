    fun nodeConnected(own: Member, nodeName: Member) {
        connectedNodes += nodeName
        logger.log(Level.INFO, "Node $nodeName connected. Total connected: ${connectedNodes.size}/${expectedNodes.size}")

        if (connectedNodes.size == expectedNodes.size) {
            val diagram = StringBuilder()
            diagram.append("\nMembers: [${connectedNodes.size}/${expectedNodes.size}] {\n")
            expectedNodes.forEach {
                if (it.identifier.equals(own.identifier)) {
                    diagram.append("     Member [${it.address.host}]:${it.address.port} this")
                } else {
                    diagram.append("     Member [${it.address.host}]:${it.address.port}")
                }
                diagram.append("\n")
            }

            diagram.append("}")
            logger.log(Level.INFO, diagram.toString())
        }
    }